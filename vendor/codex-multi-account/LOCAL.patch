+function localThresholds() {
+  const file = process.env.CX_LOCAL_THRESHOLD_FILE;
+  if (!file) return {};
+  try {
+    if (fs.lstatSync(file).isSymbolicLink()) return null;
+    const data = JSON.parse(fs.readFileSync(file, "utf8"));
+    if (data?.version !== 1 || !data.thresholds || typeof data.thresholds !== "object" || Array.isArray(data.thresholds)) return null;
+    if (Object.entries(data.thresholds).some(([k,v]) => !/^[A-H]$/.test(k) || !Number.isInteger(v) || v < 0 || v > 99)) return null;
+    return data.thresholds;
+  } catch (error) { return error.code === "ENOENT" ? {} : null; }
+}
+
+function belowReserve(result, thresholds) {
+  const threshold = thresholds?.[result?.account?.name] || 0;
+  const used = rawUsedPercent(fiveHourQuotaBucket(result?.limits));
+  return Boolean(threshold > 0 && result?.ok && Number.isFinite(used) && used >= 0 && used <= 100 && 100 - used <= threshold);
+}
+
+function applyReserveThresholds(results, thresholds) {
+  return results.map(result => {
+    const threshold = thresholds?.[result?.account?.name] || 0;
+    const used = rawUsedPercent(fiveHourQuotaBucket(result?.limits));
+    if (result?.ok && threshold > 0 && (!Number.isFinite(used) || used < 0 || used > 100))
+      return {...result, ok: false, error: "5h quota unknown while reserve is enabled"};
+    return belowReserve(result, thresholds)
+      ? {...result, ok: false, error: `5h remaining at or below ${threshold}% reserve`}
+      : result;
+  });
